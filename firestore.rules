rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidJournalEntry(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 4000))
        && data.messages is list && data.messages.size() <= 100
        && (data.messages.size() == 0 || data.messages[0] is map)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User-isolated journal entries and AI reflections
    match /users/{userId}/entries/{entryId} {
      allow get: if isOwner(userId) && isValidId(entryId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidId(entryId)
        && incoming().userId == request.auth.uid
        && incoming().id == entryId
        && isValidJournalEntry(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(entryId)
        && isValidJournalEntry(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasAny(['title', 'summary', 'messages', 'tags', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(entryId);
    }
  }
}
